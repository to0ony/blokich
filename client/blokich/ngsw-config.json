{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/_vercel/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/icons/**", "/media/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "raspored",
      "urls": [
        "https://baza.blokich-dev.eu/api/vozac-rasporedvoznje/**",
        "https://baza.blokich-dev.eu/api/vozac-rasporedVoznje/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 40,
        "maxAge": "14d",
        "timeout": "6s"
      }
    }
  ]
}
